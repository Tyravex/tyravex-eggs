{
  "schemaVersion": 1,
  "id": "tyravex.telegram.nodejs",
  "name": "Telegram Bot - Node.js",
  "description": "Node.js runtime for a user-provided Telegram bot project.",
  "version": "1.0.0",
  "category": "bots",
  "runtime": {
    "type": "docker",
    "image": "node:22-bookworm-slim",
    "workingDirectory": "/app",
    "defaultVersion": "22",
    "versions": [
      {
        "version": "20",
        "image": "node:20-bookworm-slim"
      },
      {
        "version": "22",
        "image": "node:22-bookworm-slim"
      },
      {
        "version": "24",
        "image": "node:24-bookworm-slim"
      }
    ]
  },
  "install": {
    "mode": "nodejs",
    "packageManager": "npm"
  },
  "startup": {
    "mode": "npm-start"
  },
  "defaultProfile": "telegraf",
  "profiles": [
    {
      "id": "telegraf",
      "name": "Telegraf",
      "startup": {
        "mode": "npm-start"
      },
      "runtimeVersion": "22"
    },
    {
      "id": "grammy",
      "name": "grammY",
      "startup": {
        "mode": "npm-start"
      },
      "runtimeVersion": "22"
    },
    {
      "id": "generic",
      "name": "Generic Telegram Node.js",
      "startup": {
        "mode": "node-file",
        "entrypoint": "bot.js"
      },
      "runtimeVersion": "22"
    }
  ],
  "variables": [
    {
      "name": "TELEGRAM_BOT_TOKEN",
      "type": "secret",
      "required": true
    }
  ]
}

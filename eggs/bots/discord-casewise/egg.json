{
  "schemaVersion": 1,
  "id": "tyravex.discord.casewise",
  "name": "CaseWise Discord Bot",
  "description": "CaseWise Discord bot from the public ZabKoz/CaseWise project. Use ref Master and project directory bot. Requires a Discord token and an existing MongoDB database.",
  "version": "1.0.0",
  "category": "bots",
  "runtime": {
    "type": "docker",
    "image": "node:22-bookworm-slim",
    "workingDirectory": "/app",
    "defaultVersion": "22",
    "versions": [
      {
        "version": "22",
        "image": "node:22-bookworm-slim"
      }
    ]
  },
  "install": {
    "mode": "nodejs",
    "packageManager": "npm"
  },
  "startup": {
    "mode": "node-file",
    "entrypoint": "src/index.js"
  },
  "defaultProfile": "casewise",
  "profiles": [
    {
      "id": "casewise",
      "name": "CaseWise",
      "startup": {
        "mode": "node-file",
        "entrypoint": "src/index.js"
      },
      "runtimeVersion": "22"
    }
  ],
  "variables": [
    {
      "name": "TOKEN",
      "type": "secret",
      "required": true
    },
    {
      "name": "MONGO_URI",
      "type": "secret",
      "required": true
    },
    {
      "name": "DEVELOPERMODE",
      "type": "string",
      "required": false
    }
  ]
}

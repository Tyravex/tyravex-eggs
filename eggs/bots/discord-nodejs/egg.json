{
  "schemaVersion": 1,
  "id": "tyravex.discord.nodejs",
  "name": "Discord Bot - Node.js",
  "description": "Node.js runtime for a user-provided Discord bot project.",
  "version": "1.2.0",
  "category": "bots",
  "runtime": {
    "type": "docker",
    "image": "node:22-bookworm-slim",
    "workingDirectory": "/app",
    "defaultVersion": "22",
    "versions": [
      {
        "version": "20",
        "image": "node:20-bookworm-slim"
      },
      {
        "version": "22",
        "image": "node:22-bookworm-slim"
      },
      {
        "version": "24",
        "image": "node:24-bookworm-slim"
      }
    ]
  },
  "install": {
    "mode": "nodejs",
    "packageManager": "npm"
  },
  "startup": {
    "mode": "npm-start"
  },
  "defaultProfile": "discordjs",
  "profiles": [
    {
      "id": "discordjs",
      "name": "Discord.js",
      "startup": {
        "mode": "npm-start"
      },
      "runtimeVersion": "22"
    },
    {
      "id": "dbm",
      "name": "Discord Bot Maker",
      "startup": {
        "mode": "node-file",
        "entrypoint": "bot.js"
      },
      "runtimeVersion": "22"
    },
    {
      "id": "typescript",
      "name": "TypeScript (compiled)",
      "startup": {
        "mode": "node-file",
        "entrypoint": "dist/main.js"
      },
      "runtimeVersion": "22"
    },
    {
      "id": "generic",
      "name": "Generic Node.js",
      "startup": {
        "mode": "node-file",
        "entrypoint": "index.js"
      },
      "runtimeVersion": "22"
    },
    {
      "id": "dynamica",
      "name": "Dynamica",
      "startup": {
        "mode": "node-file",
        "entrypoint": "dist/main.js"
      },
      "runtimeVersion": "22",
      "install": {
        "mode": "nodejs",
        "packageManager": "pnpm"
      },
      "application": {
        "description": "Dynamic voice-channel management for Discord.",
        "author": "DynamicaBot",
        "version": "3.3.6 (main)",
        "repositoryUrl": "https://github.com/DynamicaBot/Dynamica-V2.git",
        "reference": "main",
        "subdirectory": ".",
        "requirements": "An initialized PostgreSQL database and TOKEN / POSTGRES_URL are required. Requires the Agent pnpm capability. No database is provisioned and the optional HTTP API is not exposed. Discord login has not been smoke-tested."
      },
      "variables": [
        {
          "name": "TOKEN",
          "required": true,
          "secret": true
        },
        {
          "name": "POSTGRES_URL",
          "required": true,
          "secret": true
        },
        {
          "name": "NODE_ENV",
          "required": false,
          "secret": false
        },
        {
          "name": "SENTRY_DSN",
          "required": false,
          "secret": true
        },
        {
          "name": "MQTT_URL",
          "required": false,
          "secret": false
        },
        {
          "name": "MQTT_USER",
          "required": false,
          "secret": false
        },
        {
          "name": "MQTT_PASS",
          "required": false,
          "secret": true
        }
      ]
    }
  ],
  "variables": [
    {
      "name": "DISCORD_TOKEN",
      "type": "secret",
      "required": true
    }
  ]
}

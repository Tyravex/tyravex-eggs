{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/Tyravex/tyravex-eggs/blob/main/schemas/v2/egg.schema.json",
    "title": "Tyravex Egg v2 draft",
    "description": "Declarative manifest contract; not an execution permission or installer.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "metadata",
        "runtime",
        "source",
        "network",
        "storage",
        "lifecycle",
        "variables"
    ],
    "properties": {
        "schemaVersion": {
            "const": 2
        },
        "metadata": {
            "$ref": "#/$defs/metadata"
        },
        "runtime": {
            "$ref": "#/$defs/image"
        },
        "source": {
            "$ref": "#/$defs/source"
        },
        "network": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "ports"
            ],
            "properties": {
                "ports": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "$ref": "#/$defs/port"
                    }
                }
            }
        },
        "storage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mounts"
            ],
            "properties": {
                "mounts": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                        "$ref": "#/$defs/mount"
                    }
                }
            }
        },
        "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start"
            ],
            "properties": {
                "start": {
                    "$ref": "#/$defs/process"
                }
            }
        },
        "variables": {
            "type": "array",
            "maxItems": 32,
            "items": {
                "$ref": "#/$defs/variable"
            }
        }
    },
    "$defs": {
        "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "description",
                "version",
                "category"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "category": {
                    "enum": [
                        "bots",
                        "games",
                        "applications"
                    ]
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "reference",
                "workingDirectory"
            ],
            "properties": {
                "reference": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*@sha256:[a-f0-9]{64}$"
                },
                "workingDirectory": {
                    "const": "/app"
                }
            }
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "none",
                        "archive"
                    ]
                },
                "url": {
                    "type": "string",
                    "pattern": "^https://[^?#\\s]+$"
                },
                "sha256": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        },
        "port": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "protocol",
                "containerPort"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "protocol": {
                    "enum": [
                        "tcp",
                        "udp"
                    ]
                },
                "containerPort": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            }
        },
        "mount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "containerPath"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "containerPath": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
                }
            }
        },
        "process": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "executable",
                "args"
            ],
            "properties": {
                "executable": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
                },
                "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "type": "string",
                        "maxLength": 512
                    }
                }
            }
        },
        "variable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "type",
                "required"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "type": {
                    "enum": [
                        "string",
                        "secret"
                    ]
                },
                "required": {
                    "type": "boolean"
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "source": {
                        "properties": {
                            "kind": {
                                "const": "archive"
                            }
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "source": {
                        "required": [
                            "kind",
                            "url",
                            "sha256"
                        ]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "source": {
                        "properties": {
                            "kind": {
                                "const": "none"
                            }
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "source": {
                        "not": {
                            "anyOf": [
                                {
                                    "required": [
                                        "url"
                                    ]
                                },
                                {
                                    "required": [
                                        "sha256"
                                    ]
                                }
                            ]
                        }
                    }
                }
            }
        }
    ]
}
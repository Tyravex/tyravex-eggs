{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/Tyravex/tyravex-eggs/blob/main/schemas/v2/egg.schema.json",
    "title": "Tyravex Egg v2 draft",
    "description": "Declarative manifest contract; not an execution permission or installer.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "metadata",
        "runtime",
        "source",
        "network",
        "storage",
        "lifecycle",
        "variables"
    ],
    "properties": {
        "schemaVersion": {
            "const": 2
        },
        "metadata": {
            "$ref": "#/$defs/metadata"
        },
        "runtime": {
            "$ref": "#/$defs/image"
        },
        "source": {
            "$ref": "#/$defs/source"
        },
        "network": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "ports"
            ],
            "properties": {
                "ports": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "$ref": "#/$defs/port"
                    }
                }
            }
        },
        "storage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mounts"
            ],
            "properties": {
                "mounts": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                        "$ref": "#/$defs/mount"
                    }
                }
            }
        },
        "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start"
            ],
            "properties": {
                "start": {
                    "$ref": "#/$defs/process"
                }
            }
        },
        "variables": {
            "type": "array",
            "maxItems": 32,
            "items": {
                "$ref": "#/$defs/variable"
            }
        },
        "artwork": {
            "$ref": "#/$defs/artwork"
        },
        "provisioning": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "versions"
                    ],
                    "properties": {
                        "kind": {
                            "const": "minecraft-vanilla"
                        },
                        "versions": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "channels",
                                "allowlist"
                            ],
                            "properties": {
                                "channels": {
                                    "type": "array",
                                    "minItems": 1,
                                    "maxItems": 4,
                                    "uniqueItems": true,
                                    "items": {
                                        "enum": [
                                            "release",
                                            "snapshot",
                                            "old_beta",
                                            "old_alpha"
                                        ]
                                    }
                                },
                                "allowlist": {
                                    "type": "array",
                                    "maxItems": 1000,
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 100,
                                        "pattern": "^[A-Za-z0-9_.+ -]+$"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "game",
                        "appId",
                        "login",
                        "branch",
                        "platform",
                        "architecture",
                        "stopSignal",
                        "stopTimeoutSeconds"
                    ],
                    "properties": {
                        "kind": {
                            "const": "steamcmd"
                        },
                        "game": {
                            "const": "valheim"
                        },
                        "appId": {
                            "const": 896660
                        },
                        "login": {
                            "const": "anonymous"
                        },
                        "branch": {
                            "const": "public"
                        },
                        "platform": {
                            "const": "linux"
                        },
                        "architecture": {
                            "const": "amd64"
                        },
                        "stopSignal": {
                            "const": "SIGINT"
                        },
                        "stopTimeoutSeconds": {
                            "const": 120
                        }
                    }
                }
            ]
        }
    },
    "$defs": {
        "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "description",
                "version",
                "category"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "category": {
                    "enum": [
                        "bots",
                        "games",
                        "applications"
                    ]
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "reference",
                "workingDirectory"
            ],
            "properties": {
                "reference": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*@sha256:[a-f0-9]{64}$"
                },
                "workingDirectory": {
                    "const": "/app"
                }
            }
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "none",
                        "archive"
                    ]
                },
                "url": {
                    "type": "string",
                    "pattern": "^https://[^?#\\s]+$"
                },
                "sha256": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        },
        "port": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "protocol",
                "containerPort"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "protocol": {
                    "enum": [
                        "tcp",
                        "udp"
                    ]
                },
                "containerPort": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            }
        },
        "mount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "containerPath"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "containerPath": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
                }
            }
        },
        "process": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "executable",
                "args"
            ],
            "properties": {
                "executable": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
                },
                "args": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "type": "string",
                        "maxLength": 512
                    }
                }
            }
        },
        "variable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "type",
                "required"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "type": {
                    "enum": [
                        "string",
                        "secret"
                    ]
                },
                "required": {
                    "type": "boolean"
                }
            }
        },
        "artworkImage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "sha256"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "maxLength": 300,
                    "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|jpe?g|webp)$",
                    "not": {
                        "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
                    }
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        },
        "artwork": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
                "banner": {
                    "$ref": "#/$defs/artworkImage"
                },
                "icon": {
                    "$ref": "#/$defs/artworkImage"
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "type": "object",
                "required": [
                    "source"
                ],
                "properties": {
                    "source": {
                        "type": "object",
                        "required": [
                            "kind"
                        ],
                        "properties": {
                            "kind": {
                                "const": "archive"
                            }
                        }
                    }
                }
            },
            "then": {
                "type": "object",
                "properties": {
                    "source": {
                        "type": "object",
                        "required": [
                            "url",
                            "sha256"
                        ],
                        "properties": {
                            "url": true,
                            "sha256": true
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": [
                    "source"
                ],
                "properties": {
                    "source": {
                        "type": "object",
                        "required": [
                            "kind"
                        ],
                        "properties": {
                            "kind": {
                                "const": "none"
                            }
                        }
                    }
                }
            },
            "then": {
                "type": "object",
                "properties": {
                    "source": {
                        "type": "object",
                        "properties": {
                            "url": false,
                            "sha256": false
                        }
                    }
                }
            }
        }
    ]
}

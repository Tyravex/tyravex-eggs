{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tyravex Egg v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "category",
    "runtime",
    "install",
    "startup",
    "variables"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "category": {
      "enum": [
        "bots",
        "games",
        "applications"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "image",
        "workingDirectory"
      ],
      "properties": {
        "type": {
          "const": "docker"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "workingDirectory": {
          "const": "/app"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "image"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^(?:[0-9]+|3\\.(?:11|12|13))$"
              },
              "image": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            }
          }
        },
        "defaultVersion": {
          "type": "string",
          "pattern": "^(?:[0-9]+|3\\.(?:11|12|13))$"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "packageManager"
      ],
      "properties": {
        "mode": {
          "enum": [
            "nodejs",
            "python"
          ]
        },
        "packageManager": {
          "enum": [
            "npm",
            "pip"
          ]
        }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "npm-start",
            "node-file",
            "python-file"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+\\.(?:[cm]?js|py)$"
        }
      }
    },
    "defaultProfile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "startup"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "startup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "npm-start",
                  "node-file",
                  "python-file"
                ]
              },
              "entrypoint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+\\.(?:[cm]?js|py)$"
              }
            }
          },
          "runtimeVersion": {
            "type": "string",
            "pattern": "^(?:[0-9]+|3\\.(?:11|12|13))$"
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "type": {
            "enum": [
              "string",
              "secret"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

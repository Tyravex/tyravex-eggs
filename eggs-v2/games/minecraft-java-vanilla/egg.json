{
    "schemaVersion": 2,
    "metadata": {
        "id": "tyravex.minecraft.java.vanilla",
        "name": "Minecraft Java - Vanilla",
        "description": "Minecraft Java Vanilla template with default artwork and administrator-controlled official version availability. Execution requires Minecraft provisioning support in the panel and agent.",
        "version": "1.1.0",
        "category": "games"
    },
    "runtime": {
        "reference": "docker.io/library/eclipse-temurin@sha256:0eda5830ed7b669abc246a8dc520ea8a23cab06f9a8d4b6964109e2f2394e46f",
        "workingDirectory": "/app"
    },
    "source": {
        "kind": "none"
    },
    "network": {
        "ports": [
            {
                "name": "minecraft",
                "protocol": "tcp",
                "containerPort": 25565
            }
        ]
    },
    "storage": {
        "mounts": [
            {
                "name": "minecraft-data",
                "containerPath": "/data"
            }
        ]
    },
    "lifecycle": {
        "start": {
            "executable": "java",
            "args": [
                "-jar",
                "/data/server.jar",
                "nogui"
            ]
        }
    },
    "variables": [],
    "artwork": {
        "banner": {
            "path": "artwork/minecraft/vanilla/banner.png",
            "sha256": "e9276ba9757d84122b960cc14869f0fda8cf42bbfcf1d8f40ef210534076326b"
        }
    },
    "provisioning": {
        "kind": "minecraft-vanilla",
        "versions": {
            "channels": [
                "release"
            ],
            "allowlist": []
        }
    }
}
